# Empty key = explicitly labeled, deterministic demo recommendations.
CLOVA_STUDIO_API_KEY=
CLOVA_STUDIO_MODEL=HCX-005
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tourpass
# Set to require or no-verify if PostgreSQL enforces TLS.
DATABASE_SSL=false
# Set to https://your-domain when deployed behind a reverse proxy.
APP_ORIGIN=http://localhost:3000
# Set true only behind HTTPS; local HTTP must use false.
COOKIE_SECURE=false
# Function Calling and image understanding can use separate v3 models.
CLOVA_FUNCTION_MODEL=HCX-DASH-002
CLOVA_VISION_MODEL=HCX-005
# AI·NAVER API application with CLOVA Voice enabled.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Papago Translation application credentials (separate application).
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=
# General OCR domain invoke URL, ending in /general.
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=

# NAVER Developers login application (separate from CLOVA Voice).
# Callback URL: <APP_ORIGIN>/api/auth/naver/callback
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=

# NAVER Cloud Platform Maps (Web Dynamic Map v3) Client ID (ncpKeyId).
# Register APP_ORIGIN as Web Service URL in the console. Empty value falls back to built-in SVG map.
NAVER_MAP_CLIENT_ID=

# NAVER API HUB search (local + blog) for restaurants on the weather tab. Empty = restaurant card shows a setup notice.
NAVER_SEARCH_ID=
NAVER_SEARCH_SECRET=

# Development-only TourAPI data importer. Never prefix with NEXT_PUBLIC_.
TOUR_API_KEY=
